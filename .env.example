VITE_API_BASE_URL=http://localhost:8000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-output-from-npm-run-supabase-env
SUPABASE_SERVICE_ROLE_KEY=replace-with-output-from-npm-run-supabase-env
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=video-caption-pipeline
APP_ENV=development
APP_DEBUG=true
APP_FORCE_HTTPS=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT_MAX_REQUESTS=20
START_LOCAL_REDIS=false
GOOGLE_GEMINI_API_KEY=replace-with-google-gemini-api-key
GOOGLE_GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash
FIREWORKS_API_KEY=replace-with-fireworks-api-key
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/gemma-4-31b-it-nvfp4
FIREWORKS_TIMEOUT_SECONDS=90
FIREWORKS_MAX_RETRIES=3
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FINAL_CAPTION_MODEL=gpt-5.5
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=3
OPENAI_REASONING_EFFORT=medium
OPENAI_TEXT_VERBOSITY=medium
