{
  "name": "video-caption-pipeline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "nx": "NX_DAEMON=false nx",
    "dev:web": "vite --config apps/web/vite.config.ts --host 0.0.0.0",
    "dev:api": "cd apps/api && python3 manage.py runserver 0.0.0.0:8000",
    "dev": "concurrently -k -n web,api -c blue,green \"npm run dev:web\" \"npm run dev:api\"",
    "supabase:start": "supabase start -x realtime,imgproxy,mailpit,edge-runtime,logflare,vector,supavisor",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:env": "supabase status -o env",
    "build": "tsc -b apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "lint": "eslint \"apps/web/src/**/*.{ts,tsx}\" \"libs/shared-types/src/**/*.ts\"",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "check:api": "cd apps/api && python3 manage.py check",
    "test:api": "cd apps/api && python3 manage.py test",
    "test:web": "vitest run --config apps/web/vite.config.ts",
    "test": "npm run test:web && npm run test:api",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "nx": "^20.0.7",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
